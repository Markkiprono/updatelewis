# Copy this file to .env and fill it in. Never commit .env.

# MongoDB connection string. Leave empty to run with a temporary demo database.
MONGO_URI=

# Long random string used to sign login tokens
JWT_SECRET=

# First admin account, created automatically if no admin exists yet
ADMIN_EMAIL=admin@groupwork.local
ADMIN_PASSWORD=change-me-please

# Optional
PORT=5000
# DEMO=true   # force the demo database even when MONGO_URI is set
